,"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID220","DisplayLogic":{"0":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">pro_change<\/span> <span class=\"OpDesc\">Is Not Equal to<\/span> <span class=\"RightOpDesc\"> 0 <\/span>","LeftOperand":"pro_change","LogicType":"EmbeddedField","Operator":"NotEqualTo","RightOperand":"0","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"RecodeValues":{"1":"-3","2":"-2","3":"-1","4":"0","5":"1","6":"2","7":"3"}}},{"SurveyID":"SV_8pFXWyvs2Y7YcMC","Element":"SQ","PrimaryAttribute":"QID221","SecondaryAttribute":"How do you believe this change would impact the well-being of others?","TertiaryAttribute":null,"Payload":{"QuestionText":"How do you believe this change would impact  the well-being of others?","DefaultChoices":false,"DataExportTag":"Pro_others","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How do you believe this change would impact the well-being of others?","Choices":{"1":{"Display":"Extremely negative impact"},"2":{"Display":"Moderately negative impact"},"3":{"Display":"Somewhat negative impact"},"4":{"Display":"No impact"},"5":{"Display":"Somewhat positive impact"},"6":{"Display":"Moderately positive impact"},"7":{"Display":"Extremely positive impact"}},"ChoiceOrder":[1,2,3,4,5,6,7],"Validation":{"Settings":{"ForceResponse":"RequestResponse","ForceResponseType":"RequestResponse","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID221","DisplayLogic":{"0":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">pro_change<\/span> <span class=\"OpDesc\">Is Not Equal to<\/span> <span class=\"RightOpDesc\"> 0 <\/span>","LeftOperand":"pro_change","LogicType":"EmbeddedField","Operator":"NotEqualTo","RightOperand":"0","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"RecodeValues":{"1":"-3","2":"-2","3":"-1","4":"0","5":"1","6":"2","7":"3"}}},{"SurveyID":"SV_8pFXWyvs2Y7YcMC","Element":"SQ","PrimaryAttribute":"QID222","SecondaryAttribute":"Click the bullet in the answer that best represents your opinion. Prosociality: Persons who are h...","TertiaryAttribute":null,"Payload":{"QuestionText":"Click the bullet in the answer that best represents your opinion.<br \/>\n<br \/>\n<b>Prosociality: <\/b>Persons who are high in prosociality (a trait researchers sometimes call Honesty-Humility) avoid manipulating others for personal gain, feel little temptation to break rules, are uninterested in lavish wealth and luxuries, feel no special entitlement to elevated social status, and engage in behaviors that benefit other people. Conversely, persons with very low scores on this scale will flatter others to get what they want, are inclined to break rules for personal profit, are motivated by material gain, and feel a strong sense of self-importance.","DefaultChoices":false,"DataExportTag":"Pro_Instr","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click the bullet in the answer that best represents your opinion. Prosociality: Persons who are h...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID222"}},{"SurveyID":"SV_8pFXWyvs2Y7YcMC","Element":"SQ","PrimaryAttribute":"QID223","SecondaryAttribute":"Click the bullet in the answer that best represents your opinion. Emotionality: Persons with very...","TertiaryAttribute":null,"Payload":{"QuestionText":"Click the bullet in the answer that best represents your opinion.<br><br><b>Emotionality:<\/b> Persons with very high scores on the Emotionality scale experience fear of physical dangers, experience anxiety in response to life's stresses, feel a need for emotional support from others, and feel empathy and sentimental attachments with others. Conversely, persons with very low scores on this scale are not deterred by the prospect of physical harm, feel little worry even in stressful situations, have little need to share their concerns with others, and feel emotionally detached from others.<br>","DefaultChoices":false,"DataExportTag":"E_Instr","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click the bullet in the answer that best represents your opinion. Emotionality: Persons with very...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID223"}},{"SurveyID":"SV_8pFXWyvs2Y7YcMC","Element":"SQ","PrimaryAttribute":"QID224","SecondaryAttribute":"If I could change myself, I would like to be lower\/higher in Emotionality.","TertiaryAttribute":null,"Payload":{"QuestionText":"If I could change myself, I would like to be lower\/higher in Emotionality.","DefaultChoices":false,"DataExportTag":"E_change","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"If I could change myself, I would like to be lower\/higher in Emotionality.","Choices":{"1":{"Display":"Much lower"},"2":{"Display":"Lower"},"3":{"Display":"Slightly lower"},"4":{"Display":"Neither lower nor higher"},"5":{"Display":"Slightly higher"},"6":{"Display":"Higher"},"7":{"Display":"Much higher"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID224"}},{"SurveyID":"SV_8pFXWyvs2Y7YcMC","Element":"SQ","PrimaryAttribute":"QID225","SecondaryAttribute":"Click the bullet in the answer that best represents your opinion. Extraversion: Persons with very...","TertiaryAttribute":null,"Payload":{"QuestionText":"Click the bullet in the answer that best represents your opinion.<br><br><b>Extraversion:<\/b> Persons with very high scores on the Extraversion scale feel positively about themselves, feel confident when leading or addressing groups of people, enjoy social gatherings and interactions, and experience positive feelings of enthusiasm and energy. Conversely, persons with very low scores on this scale consider themselves unpopular, feel awkward when they are the center of social attention, are indifferent to social activities, and feel less lively and optimistic than others do.<br>","DefaultChoices":false,"DataExportTag":"X_Instr","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click the bullet in the answer that best represents your opinion. Extraversion: Persons with very...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID225"}},{"SurveyID":"SV_8pFXWyvs2Y7YcMC","Element":"SQ","PrimaryAttribute":"QID226","SecondaryAttribute":"If I could change myself, I would like to be lower\/higher on Extraversion.","TertiaryAttribute":null,"Payload":{"QuestionText":"If I could change myself, I would like to be lower\/higher on Extraversion.","DefaultChoices":false,"DataExportTag":"X_change","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"If I could change myself, I would like to be lower\/higher on Extraversion.","Choices":{"1":{"Display":"Much lower"},"2":{"Display":"Lower"},"3":{"Display":"Slightly lower"},"4":{"Display":"Neither lower nor higher"},"5":{"Display":"Slightly higher"},"6":{"Display":"Higher"},"7":{"Display":"Much higher"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID226"}},{"SurveyID":"SV_8pFXWyvs2Y7YcMC","Element":"SQ","PrimaryAttribute":"QID227","SecondaryAttribute":"Click the bullet in the answer that best represents your opinion. Agreeableness: Persons with ver...","TertiaryAttribute":null,"Payload":{"QuestionText":"Click the bullet in the answer that best represents your opinion.<br><br><b>Agreeableness:<\/b> Persons with very high scores on the Agreeableness scale forgive the wrongs that they suffered, are lenient in judging others, are willing to compromise and cooperate with others, and can easily control their temper. Conversely, persons with very low scores on this scale hold grudges against those who have harmed them, are rather critical of others' shortcomings, are stubborn in defending their point of view, and feel anger readily in response to mistreatment.\n\n<br>","DefaultChoices":false,"DataExportTag":"A_Instr","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click the bullet in the answer that best represents your opinion. Agreeableness: Persons with ver...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID227"}},{"SurveyID":"SV_8pFXWyvs2Y7YcMC","Element":"SQ","PrimaryAttribute":"QID228","SecondaryAttribute":"If I could change myself, I would like to be lower\/higher on Agreeableness.","TertiaryAttribute":null,"Payload":{"QuestionText":"If I could change myself, I would like to be lower\/higher on Agreeableness.","DefaultChoices":false,"DataExportTag":"A_change","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"If I could change myself, I would like to be lower\/higher on Agreeableness.","Choices":{"1":{"Display":"Much lower"},"2":{"Display":"Lower"},"3":{"Display":"Slightly lower"},"4":{"Display":"Neither lower nor higher"},"5":{"Display":"Slightly higher"},"6":{"Display":"Higher"},"7":{"Display":"Much higher"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID228"}},{"SurveyID":"SV_8pFXWyvs2Y7YcMC","Element":"SQ","PrimaryAttribute":"QID229","SecondaryAttribute":"Click the bullet in the answer that best represents your opinion. Conscientiousness: Persons with...","TertiaryAttribute":null,"Payload":{"QuestionText":"Click the bullet in the answer that best represents your opinion.<br><br><b>Conscientiousness: <\/b> Persons with very high scores on the Conscientiousness scale organize their time and their physical surroundings, work in a disciplined way toward their goals, strive for accuracy and perfection in their tasks, and deliberate carefully when making decisions. Conversely, persons with very low scores on this scale tend to be unconcerned with orderly surroundings or schedules, avoid difficult tasks or challenging goals, are satisfied with work that contains some errors, and make decisions on impulse or with little reflection.\n\n<br>","DefaultChoices":false,"DataExportTag":"C_Instr","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click the bullet in the answer that best represents your opinion. Conscientiousness: Persons with...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID229"}},{"SurveyID":"SV_8pFXWyvs2Y7YcMC","Element":"SQ","PrimaryAttribute":"QID230","SecondaryAttribute":"If I could change myself, I would like to be lower\/higher on Conscientiousness.","TertiaryAttribute":null,"Payload":{"QuestionText":"If I could change myself, I would like to be lower\/higher on Conscientiousness.","DefaultChoices":false,"DataExportTag":"C_change","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"If I could change myself, I would like to be lower\/higher on Conscientiousness.","Choices":{"1":{"Display":"Much lower"},"2":{"Display":"Lower"},"3":{"Display":"Slightly lower"},"4":{"Display":"Neither lower nor higher"},"5":{"Display":"Slightly higher"},"6":{"Display":"Higher"},"7":{"Display":"Much higher"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID230"}},{"SurveyID":"SV_8pFXWyvs2Y7YcMC","Element":"SQ","PrimaryAttribute":"QID231","SecondaryAttribute":"Click the bullet in the answer that best represents your opinion. Openness to Experience: Persons...","TertiaryAttribute":null,"Payload":{"QuestionText":"Click the bullet in the answer that best represents your opinion.<br><br><b>Openness to Experience: <\/b>Persons with very high scores on the Openness to Experience scale become absorbed in the beauty of art and nature, are inquisitive about various domains of knowledge, use their imagination freely in everyday life, and take an interest in unusual ideas or people. Conversely, persons with very low scores on this scale are rather unimpressed by most works of art, feel little intellectual curiosity, avoid creative pursuits, and feel little attraction toward ideas that may seem radical or unconventional.<br>","DefaultChoices":false,"DataExportTag":"O_Instr","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click the bullet in the answer that best represents your opinion. Openness to Experience: Persons...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID231"}},{"SurveyID":"SV_8pFXWyvs2Y7YcMC","Element":"SQ","PrimaryAttribute":"QID232","SecondaryAttribute":"If I could change myself, I would like to be lower\/higher on Openness to Experience.","TertiaryAttribute":null,"Payload":{"QuestionText":"If I could change myself, I would like to be lower\/higher on Openness to Experience.","DefaultChoices":false,"DataExportTag":"O_change","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"If I could change myself, I would like to be lower\/higher on Openness to Experience.","Choices":{"1":{"Display":"Much lower"},"2":{"Display":"Lower"},"3":{"Display":"Slightly lower"},"4":{"Display":"Neither lower nor higher"},"5":{"Display":"Slightly higher"},"6":{"Display":"Higher"},"7":{"Display":"Much higher"}},"ChoiceOrder":["1","2","3","4","5","6","7"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID232"}},{"SurveyID":"SV_8pFXWyvs2Y7YcMC","Element":"SQ","PrimaryAttribute":"QID233","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"Q218","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Validation":{"Settings":{"For